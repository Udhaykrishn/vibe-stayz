---
import type {Field} from '../../lib/cms-config';import type {SiteData} from '../../types';
interface Props {field:Field;value:unknown;data:SiteData;}
const {field:f,value,data}=Astro.props;const id=`field-${f.key}`;const options=f.relation?data[f.relation].map(r=>({id:r.id,label:r.name})):f.options?.map(s=>({id:s,label:s}))||[];
---
<div class:list={['field','cms-field',f.full&&'full',f.type==='checkbox'&&'checkbox-field']}>
{f.type==='checkbox'?<label for={id}><input type="checkbox" id={id} name={f.key} checked={!!value}/><span>{f.label}</span></label>:<><label for={id}>{f.label}{f.required&&<span class="required-mark"> *</span>}</label>{f.type==='textarea'?<textarea id={id} name={f.key} rows={f.key==='description'||f.key==='body'||f.key==='property_template'?7:3} required={f.required}>{String(value??'')}</textarea>:f.type==='select'?<select id={id} name={f.key} required={f.required}>{(!f.required||!value)&&<option value="">Select {f.label.toLowerCase()}</option>}{options.map(o=><option value={o.id} selected={value===o.id}>{o.label}</option>)}</select>:<input id={id} name={f.key} type={f.type==='number'?'number':f.type==='date'?'date':f.type==='email'?'email':'text'} value={String(value??'')} required={f.required} min={f.key==='max_guests'||f.key==='rating'?1:0} max={f.key==='rating'?5:undefined} step={f.type==='number'?1:undefined}/>}</>}
{f.type==='image'&&<div class="image-field-preview"><img src={String(value||'/images/heritage-640.webp')} alt="Selected image preview" width="150" height="90" data-image-preview={f.key}/><button type="button" class="button button-outline" data-choose-image={f.key}>Choose image</button><button type="button" class="plain-button" data-clear-image={f.key}>Remove</button></div>}{f.help&&<p class="field-help">{f.help}</p>}<p class="field-error" id={`${id}-error`} data-error-for={f.key} hidden></p></div>
