---
import Icon from './Icon.astro';
const {eyebrow,title,body='',href='',label='Explore more'}=Astro.props;
---
<div class="section-heading"><div><p class="eyebrow">{eyebrow}</p><h2>{title}</h2>{body&&<p class="section-intro">{body}</p>}</div>{href&&<a class="text-link" href={href}>{label}<Icon name="arrow" size={20}/></a>}</div>
