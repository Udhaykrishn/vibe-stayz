---
import Photo from '../common/Photo.astro';import Icon from '../common/Icon.astro';import type {GalleryImage} from '../../types';
interface Props {images:GalleryImage[];name:string;}
const {images,name}=Astro.props;
---
<div class:list={['property-gallery',images.length<3&&'gallery-small']} aria-label={`${name} photos`}>{images.slice(0,5).map((image,i)=><button class={`gallery-photo gallery-photo-${i}`} data-gallery-open={i} aria-label={`View photo ${i+1}: ${image.alt}`}><Photo src={image.url} alt={image.alt} eager={i===0} sizes={i===0?'(max-width:767px) 100vw, 60vw':'(max-width:767px) 100vw, 25vw'}/></button>)}<button class="gallery-all" data-gallery-open="0"><Icon name="grid" size={17}/>View all {images.length} photos</button></div>
<dialog class="lightbox" id="photo-lightbox" aria-labelledby="gallery-title"><div class="lightbox-top"><h2 id="gallery-title">{name}</h2><p id="photo-count" aria-live="polite"></p><button data-gallery-close class="icon-button" aria-label="Close gallery"><Icon name="close"/></button></div><div class="lightbox-stage"><button class="gallery-prev icon-button" aria-label="Previous photo"><Icon name="arrow"/></button><figure><img id="lightbox-image" src={images[0]?.url} alt={images[0]?.alt}/><figcaption id="photo-caption"></figcaption></figure><button class="gallery-next icon-button" aria-label="Next photo"><Icon name="arrow"/></button></div><div class="gallery-thumbs">{images.map((img,i)=><button data-photo-index={i} data-url={img.url} data-alt={img.alt} aria-label={`Show photo ${i+1}`}><img src={img.url} alt="" loading="lazy" width="100" height="70"/></button>)}</div></dialog>
<script>
const dialog=document.querySelector<HTMLDialogElement>('#photo-lightbox')!;const thumbs=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-photo-index]'));let index=0;
function show(i:number){index=(i+thumbs.length)%thumbs.length;const t=thumbs[index];const img=document.querySelector<HTMLImageElement>('#lightbox-image')!;img.src=t.dataset.url!;img.alt=t.dataset.alt||'';document.querySelector('#photo-count')!.textContent=`${index+1} / ${thumbs.length}`;document.querySelector('#photo-caption')!.textContent=img.alt;thumbs.forEach((b,j)=>b.setAttribute('aria-pressed',String(j===index)));}
document.querySelectorAll<HTMLButtonElement>('[data-gallery-open]').forEach(b=>b.addEventListener('click',()=>{show(Number(b.dataset.galleryOpen));dialog.showModal();}));document.querySelector('[data-gallery-close]')?.addEventListener('click',()=>dialog.close());thumbs.forEach((b,i)=>b.addEventListener('click',()=>show(i)));document.querySelector('.gallery-prev')?.addEventListener('click',()=>show(index-1));document.querySelector('.gallery-next')?.addEventListener('click',()=>show(index+1));dialog.addEventListener('keydown',e=>{if(e.key==='ArrowRight')show(index+1);if(e.key==='ArrowLeft')show(index-1);});let startX=0;dialog.addEventListener('touchstart',e=>{startX=e.changedTouches[0].clientX;},{passive:true});dialog.addEventListener('touchend',e=>{const delta=e.changedTouches[0].clientX-startX;if(Math.abs(delta)>50)show(index+(delta<0?1:-1));},{passive:true});
</script>
