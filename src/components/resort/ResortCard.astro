---
import type {ResortView} from '../../types';
import Photo from '../common/Photo.astro';import Icon from '../common/Icon.astro';import {money} from '../../utils/format';
interface Props {resort:ResortView;}
const {resort:r}=Astro.props;
---
<article class="stay-card">
 <a href={`/resorts/${r.slug}`} class="stay-photo" aria-label={`View ${r.name}`}><Photo src={r.cover_image} alt={r.image_alt||r.name}/><span class="photo-tag">{r.property_type}</span>{r.offers.length>0&&<span class="offer-dot">Escape idea</span>}</a>
 <div class="stay-info"><p class="card-location"><Icon name="pin" size={14}/>{r.location.name}, Kerala</p><h3><a href={`/resorts/${r.slug}`}>{r.name}</a></h3><p class="card-subtitle">{r.subtitle}</p><div class="stay-specs"><span><Icon name="users" size={17}/>{r.max_guests} guests</span>{r.bedrooms&&<span><Icon name="bed" size={17}/>{r.bedrooms} bedrooms</span>}<span><Icon name={r.amenities[0]?.icon||'leaf'} size={17}/>{r.amenities[0]?.name||'Private stay'}</span></div><div class="card-bottom"><p><strong>{money(r.starting_price)}</strong>{r.starting_price!==null&&<span> {r.price_label}</span>}</p><a class="circle-link" href={`/resorts/${r.slug}`} aria-label={`View details for ${r.name}`}><Icon name="arrow"/></a></div></div>
</article>
