---
import PublicLayout from '../../layouts/PublicLayout.astro';import LocationCard from '../../components/location/LocationCard.astro';import CTA from '../../components/common/CTA.astro';import {siteData} from '../../services/data';import {content} from '../../utils/format';const data=await siteData();const c=content(data.content,'locations','hero');
---
<PublicLayout data={data} title="Explore Kerala destinations" description={c?.body}><div class="container"><section class="page-heading"><p class="eyebrow">{c?.eyebrow}</p><h1>{c?.title}</h1><p class="lede">{c?.body}</p></section><section class="results-section"><div class="destinations-grid">{data.locations.map(l=><LocationCard location={l} count={data.resorts.filter(r=>r.location_id===l.id).length}/>)}</div>{!data.locations.length&&<div class="empty-state"><h2>Our next destinations are on their way.</h2><p>Tell us where you would like to go.</p><a class="button button-dark" href="/contact">Talk to us</a></div>}</section></div><CTA data={data}/></PublicLayout>
