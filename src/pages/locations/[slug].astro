---
import PublicLayout from '../../layouts/PublicLayout.astro';import Photo from '../../components/common/Photo.astro';import ResortCard from '../../components/resort/ResortCard.astro';import SectionHeading from '../../components/common/SectionHeading.astro';import CTA from '../../components/common/CTA.astro';import {siteData} from '../../services/data';const data=await siteData();const l=data.locations.find(x=>x.slug===Astro.params.slug);if(!l)return Astro.rewrite('/404');const resorts=data.resorts.filter(r=>r.location_id===l.id);
---
<PublicLayout data={data} title={l.seo_title||`Stays in ${l.name}`} description={l.seo_description||l.description} image={l.cover_image}><section class="destination-hero"><Photo src={l.cover_image} alt={l.image_alt||l.name} eager sizes="100vw"/><div class="container"><p class="eyebrow">FIND YOUR SOMEWHERE · KERALA</p><h1>{l.name}</h1><p>{l.subtitle}</p></div></section><div class="container"><section class="destination-description"><div><p class="eyebrow">A LITTLE ABOUT {l.name.toUpperCase()}</p><h2>A change of pace.<br/>A beautiful place.</h2></div><p>{l.description}</p></section><section class="section"><SectionHeading eyebrow="MAKE YOURSELF AT HOME" title={`Find your stay in ${l.name}`} body={`${resorts.length} ${resorts.length===1?'stay':'stays'} to discover`}/><div class="stays-grid">{resorts.map(r=><ResortCard resort={r}/>)}{!resorts.length&&<div class="empty-state"><h2>Something lovely is on its way.</h2><p>We’re adding stays in {l.name}. Browse our other destinations in the meantime.</p><a class="button button-dark" href="/resorts">Explore all stays</a></div>}</div></section></div><CTA data={data}/></PublicLayout>
