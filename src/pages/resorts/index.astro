---
import PublicLayout from '../../layouts/PublicLayout.astro';import ResortCard from '../../components/resort/ResortCard.astro';import Icon from '../../components/common/Icon.astro';import CTA from '../../components/common/CTA.astro';import {siteData} from '../../services/data';import {content} from '../../utils/format';
const data=await siteData();const c=content(data.content,'resorts','hero');const params=Astro.url.searchParams;const q=(params.get('q')||'').trim();const location=params.get('location')||'';const type=params.get('type')||'';const guests=Math.max(0,Number(params.get('guests'))||0);const selectedAmenities=params.getAll('amenity');const sort=params.get('sort')||'recommended';
let results=data.resorts.filter(r=>(!q||`${r.name} ${r.location.name} ${r.subtitle}`.toLowerCase().includes(q.toLowerCase()))&&(!location||r.location.slug===location)&&(!type||r.property_type===type)&&r.max_guests>=guests&&selectedAmenities.every(a=>r.amenities.some(x=>x.id===a)));
if(sort==='price-low')results.sort((a,b)=>(a.starting_price??Infinity)-(b.starting_price??Infinity));if(sort==='price-high')results.sort((a,b)=>(b.starting_price??0)-(a.starting_price??0));
const types=[...new Set(data.resorts.map(r=>r.property_type))];const hasFilter=!!q||!!location||!!type||!!guests||!!selectedAmenities.length;
---
<PublicLayout data={data} title="Explore resorts & private stays" description={c?.body} noindex={hasFilter}>
<div class="container"><section class="page-heading"><p class="eyebrow">{c?.eyebrow}</p><h1>{c?.title}</h1><p class="lede">{c?.body}</p></section>
<form id="resort-filters" action="/resorts" role="search"><div class="filter-form"><div class="filter-search"><label for="q">Search stays or destinations</label><input type="search" id="q" name="q" value={q} placeholder="Where would you like to escape?"/></div><div><label for="location">Destination</label><select name="location" id="location"><option value="">All destinations</option>{data.locations.map(l=><option value={l.slug} selected={location===l.slug}>{l.name}</option>)}</select></div><div><label for="type">Your kind of stay</label><select name="type" id="type"><option value="">All stay types</option>{types.map(t=><option value={t} selected={type===t}>{t}</option>)}</select></div><div><label for="guests">Group size</label><select id="guests" name="guests"><option value="">Any group size</option>{[2,4,6,8,10,12].map(n=><option value={n} selected={guests===n}>{n}+ guests</option>)}</select></div><button type="submit" class="button button-dark"><Icon name="search" size={18}/>Find stays</button></div><div class="filter-extras"><span class="filter-label">THE LITTLE EXTRAS</span>{data.amenities.filter(a=>['pool','pets','breakfast','mountain'].includes(a.id)||selectedAmenities.includes(a.id)).slice(0,6).map(a=><label><input type="checkbox" name="amenity" value={a.id} checked={selectedAmenities.includes(a.id)}/>{a.name}</label>)}{hasFilter&&<a href="/resorts" class="text-link">Clear filters<Icon name="close" size={14}/></a>}</div><div class="results-head"><p aria-live="polite"><strong>{results.length}</strong> {results.length===1?'beautiful stay':'beautiful stays'}{location?' in '+(data.locations.find(l=>l.slug===location)?.name||location):' to make your own'}</p><label for="sort" class="sort-label">Sort by <select name="sort" id="sort"><option value="recommended">Recommended</option><option value="price-low" selected={sort==='price-low'}>Price: low to high</option><option value="price-high" selected={sort==='price-high'}>Price: high to low</option></select></label></div></form>
<section class="results-section" aria-label="Resort results"><div class="stays-grid">{results.map(r=><ResortCard resort={r}/>)}{!results.length&&<div class="empty-state"><Icon name="search" size={30}/><h2>A different path to your perfect stay.</h2><p>We couldn’t find a stay matching these filters. Try another destination or a smaller group size.</p><a href="/resorts" class="button button-dark">Explore all stays</a></div>}</div></section></div><CTA data={data}/>
<script>document.querySelector('#sort')?.addEventListener('change',()=>document.querySelector<HTMLFormElement>('#resort-filters')?.requestSubmit());</script>
<style>.sort-label{display:flex;gap:9px;align-items:center;font-size:12px}.sort-label select{border:0;background:transparent;color:var(--ink);font:inherit;max-width:145px}@media(max-width:450px){.results-head{gap:15px;align-items:flex-start}.sort-label{font-size:11px;gap:4px;flex-direction:column;align-items:flex-end}.sort-label select{max-width:135px}}</style>
</PublicLayout>
