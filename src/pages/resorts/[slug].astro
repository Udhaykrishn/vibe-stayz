---
import PublicLayout from '../../layouts/PublicLayout.astro';import Gallery from '../../components/resort/Gallery.astro';import ResortCard from '../../components/resort/ResortCard.astro';import Icon from '../../components/common/Icon.astro';import Photo from '../../components/common/Photo.astro';import SectionHeading from '../../components/common/SectionHeading.astro';import {siteData} from '../../services/data';import {money,paragraphs,whatsappLink} from '../../utils/format';import {runtime} from '../../lib/env';import '../../styles/property.css';
const data=await siteData();const r=data.resorts.find(x=>x.slug===Astro.params.slug);if(!r)return Astro.rewrite('/404');const url=new URL(Astro.url.pathname,runtime().SITE_ORIGIN||Astro.url.origin).href;const wa=whatsappLink(data.settings,r,url);const similar=data.resorts.filter(x=>x.id!==r.id).sort((a,b)=>Number(b.location_id===r.location_id)-Number(a.location_id===r.location_id)||Number(b.property_type===r.property_type)-Number(a.property_type===r.property_type)).slice(0,3);const photos=r.gallery.length?r.gallery:[{id:'cover',resort_id:r.id,url:r.cover_image,alt:r.image_alt,display_order:0}];
const schema=r.is_demo?undefined:{'@context':'https://schema.org','@graph':[{'@type':'LodgingBusiness','name':r.name,'description':r.short_description,'url':url,'image':r.gallery.map(i=>new URL(i.url,url).href),'address':{'@type':'PostalAddress','addressLocality':r.location.name,'addressRegion':'Kerala','addressCountry':'IN',...(r.show_address?{streetAddress:r.address}:{})},'amenityFeature':r.amenities.map(a=>({'@type':'LocationFeatureSpecification','name':a.name,'value':true}))},{'@type':'BreadcrumbList','itemListElement':[{'@type':'ListItem','position':1,'name':'Home','item':new URL('/',url).href},{'@type':'ListItem','position':2,'name':'Resorts','item':new URL('/resorts',url).href},{'@type':'ListItem','position':3,'name':r.name,'item':url}]}]};
---
<PublicLayout data={data} title={r.seo_title||r.name} description={r.seo_description||r.short_description} image={r.cover_image} schema={schema} detail noindex={!!r.is_demo}>
<div class="container property-top"><div class="breadcrumbs"><a href="/">Home</a><Icon name="chevron"/><a href="/resorts">Resorts</a><Icon name="chevron"/><a href={`/locations/${r.location.slug}`}>{r.location.name}</a><Icon name="chevron"/><span>{r.name}</span></div><div class="property-title"><div><p class="eyebrow">{r.property_type} · {r.location.name.toUpperCase()}</p><h1>{r.name}</h1><p class="property-subtitle">{r.subtitle}</p></div><button class="button button-outline" id="share-property"><Icon name="external" size={17}/>Share this stay</button></div><p class="share-status" role="status" id="share-status"></p><Gallery images={photos} name={r.name}/>{r.is_demo===1&&<p class="property-demo">Concept stay · Sample details and rates. Images are illustrative.</p>}
<div class="property-columns"><div class="property-main"><div class="property-facts"><span><Icon name="users" size={24}/><strong>Up to {r.max_guests} guests</strong></span>{r.bedrooms&&<span><Icon name="bed" size={24}/><strong>{r.bedrooms} bedrooms</strong></span>}{r.bathrooms&&<span><Icon name="bath" size={24}/><strong>{r.bathrooms} bathrooms</strong></span>}</div><nav class="property-tabs" aria-label="Property sections"><a href="#overview">The stay</a><a href="#amenities">Amenities</a><a href="#location">Location</a><a href="#good-to-know">Good to know</a></nav>
<section id="overview" class="property-section"><p class="eyebrow">YOUR PLACE TO UNWIND</p><h2>A stay to make your own.</h2><div class="prose">{paragraphs(r.description).map(p=><p>{p}</p>)}</div>{r.highlights.length>0&&<div class="highlights">{r.highlights.map(h=><span><Icon name="check" size={16}/>{h}</span>)}</div>}</section>
<section id="amenities" class="property-section"><p class="eyebrow">THE LITTLE COMFORTS</p><h2>Everything for a lovely stay.</h2><div class="amenities-grid">{r.amenities.map(a=><div><Icon name={a.icon} size={24}/><span>{a.name}</span></div>)}</div>{!r.amenities.length&&<p class="muted">Ask our team about the amenities at this stay.</p>}</section>
<section id="location" class="property-section"><p class="eyebrow">YOUR SURROUNDINGS</p><h2>A little about {r.location.name}.</h2><div class="prose"><p>{r.location.description}</p>{r.show_address===1&&r.address&&<p><strong>Property address</strong><br/>{r.address}</p>}</div><a href={`/locations/${r.location.slug}`} class="text-link">Explore {r.location.name}<Icon name="arrow" size={17}/></a>{r.show_address===1&&r.map_url&&<a href={r.map_url} class="map-link" target="_blank" rel="noopener noreferrer"><Icon name="pin"/>View property location on map<Icon name="external" size={17}/></a>}{r.attractions.length>0&&<div class="nearby-list"><h3>Places nearby</h3>{r.attractions.map(a=><article>{a.image&&<Photo src={a.image} alt={a.name}/>}<div><h4>{a.name}</h4><span>{a.distance}{a.travel_time&&` · ${a.travel_time}`}</span><p>{a.description}</p></div></article>)}</div>}</section>
<section id="good-to-know" class="property-section"><p class="eyebrow">BEFORE YOU ARRIVE</p><h2>A few things to know.</h2><div class="arrival-times"><div><Icon name="clock"/><p>Check-in time<strong>{r.check_in}</strong></p></div><div><Icon name="clock"/><p>Check-out time<strong>{r.check_out}</strong></p></div></div>{r.rules.length>0&&<details open class="house-rules"><summary>House rules</summary><ul>{r.rules.map(rule=><li>{rule}</li>)}</ul></details>}<details class="house-rules"><summary>Pricing & stay information</summary><dl>{[['Weekday pricing',r.weekday_rate],['Weekend pricing',r.weekend_rate],['Group package',r.group_package],['Additional guests',r.extra_guest_info]].filter(([,v])=>v).map(([k,v])=><div><dt>{k}</dt><dd>{v}</dd></div>)}</dl><p>{r.pricing_disclaimer}</p></details></section></div>
<aside class="enquiry-sidebar"><div class="enquiry-card"><p class="eyebrow">YOUR NEXT ESCAPE</p><div class="enquiry-price"><strong>{money(r.starting_price)}</strong>{r.starting_price!==null&&<span>{r.price_label}</span>}</div><p class="price-intro">The whole place. Your kind of pace.</p><div class="enquiry-divider"></div><h2>Like the look of this stay?</h2><p>Let’s talk about the details. Our team can help with current pricing and everything you’d like to know.</p><a href={wa} class="button button-dark" data-property-whatsapp><Icon name="whatsapp" size={20}/>{data.settings.cta_label}</a><p class="enquiry-reassurance"><Icon name="headphones" size={15}/>A real conversation, with a real person.</p><div class="enquiry-smallprint">{r.pricing_disclaimer}</div></div><a class="help-link" href="/contact">Need a little guidance? Get in touch<Icon name="arrow" size={16}/></a></aside></div>
{similar.length>0&&<section class="section similar-section"><SectionHeading eyebrow="KEEP EXPLORING" title="You may also love…" href="/resorts" label="All stays"/><div class="stays-grid">{similar.map(s=><ResortCard resort={s}/>)}</div></section>}</div>
<div class="mobile-enquiry"><p><strong>{money(r.starting_price)}</strong><span>{r.starting_price!==null?r.price_label:'Ask our team'}</span></p><a href={wa} class="button button-dark" data-property-whatsapp><Icon name="whatsapp" size={19}/>Enquire on WhatsApp</a></div>
<script>document.querySelector('#share-property')?.addEventListener('click',async()=>{const data={title:document.title,url:window.location.href};try{if(navigator.share)await navigator.share(data);else{await navigator.clipboard.writeText(data.url);document.querySelector('#share-status')!.textContent='Stay link copied. Ready to share with your favourite people.';}}catch(e){if((e as Error).name!=='AbortError')document.querySelector('#share-status')!.textContent='You can share this stay by copying the address from your browser.';}});</script>
</PublicLayout>
