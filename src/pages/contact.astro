---
import PublicLayout from '../layouts/PublicLayout.astro';import Icon from '../components/common/Icon.astro';import {siteData} from '../services/data';import {content,whatsappLink,digits} from '../utils/format';const data=await siteData();const s=data.settings;const c=content(data.content,'contact','hero');const ready=!!digits(s.whatsapp);
---
<PublicLayout data={data} title="Contact us" description={c?.body}><div class="container"><section class="page-heading"><p class="eyebrow">{c?.eyebrow}</p><h1>{c?.title}</h1><p class="lede">{c?.body}</p></section><div class="contact-grid"><div class="contact-methods"><div class="contact-method"><span class="icon-button"><Icon name="whatsapp"/></span><div><h2>Let’s chat on WhatsApp</h2>{ready?<a href={whatsappLink(s)}>A little help with your next escape<Icon name="arrow" size={16}/></a>:<p>WhatsApp enquiries will be opening soon.</p>}</div></div>{s.phone&&<div class="contact-method"><span class="icon-button"><Icon name="phone"/></span><div><h2>Give us a call</h2><a href={`tel:${s.phone}`}>{s.phone}</a></div></div>}{s.email&&<div class="contact-method"><span class="icon-button"><Icon name="mail"/></span><div><h2>Drop us a line</h2><a href={`mailto:${s.email}`}>{s.email}</a></div></div>}{s.address&&<div class="contact-method"><span class="icon-button"><Icon name="pin"/></span><div><h2>Find us here</h2><p>{s.address}</p>{s.map_url&&<a href={s.map_url} target="_blank" rel="noopener noreferrer">Open map</a>}</div></div>}{s.business_hours&&<div class="contact-method"><span class="icon-button"><Icon name="clock"/></span><div><h2>A good time to talk</h2><p>{s.business_hours}</p></div></div>}<div class="contact-method"><span class="icon-button"><Icon name="leaf"/></span><div><h2>A personal touch</h2><p>From your first question to the finer details,<br/>we’re here to help you find your kind of stay.</p></div></div></div>
<form id="enquiry-form" class="enquiry-form" data-number={digits(s.whatsapp)} data-greeting={s.greeting}><h2>What does your getaway look like?</h2><p>Tell us a little. We’ll take it from there.</p><div class="form-grid"><div class="field"><label for="name">Your name</label><input id="name" name="name" autocomplete="name" required maxlength="100" placeholder="How should we call you?"/></div><div class="field"><label for="destination">Where would you like to go?</label><select id="destination" name="destination"><option value="I'm still exploring">I’m still exploring</option>{data.locations.map(l=><option>{l.name}</option>)}</select></div><div class="field full"><label for="message">A little about your plans</label><textarea id="message" name="message" rows="4" maxlength="2000" required placeholder="A quiet weekend for two, a family gathering, a special occasion…"></textarea></div></div><div id="enquiry-error" class="error-note" role="alert" hidden></div><button class="button button-dark" type="submit"><Icon name="whatsapp" size={20}/>Continue on WhatsApp<Icon name="arrow" size={18}/></button><p class="form-note">Your message opens in WhatsApp. You choose when to send it.</p></form></div></div>
<script>const form=document.querySelector<HTMLFormElement>('#enquiry-form');form?.addEventListener('submit',e=>{e.preventDefault();const number=form.dataset.number;const error=document.querySelector<HTMLElement>('#enquiry-error')!;if(!number){error.hidden=false;error.textContent='WhatsApp enquiries are not open yet. Please check back soon.';error.tabIndex=-1;error.focus();return;}const fd=new FormData(form);const message=`${form.dataset.greeting}\nMy name is ${fd.get('name')}.\nDestination: ${fd.get('destination')}\n\n${fd.get('message')}`;window.location.href=`https://wa.me/${number}?text=${encodeURIComponent(message)}`;});</script>
</PublicLayout>
