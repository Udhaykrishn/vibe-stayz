---
import PublicLayout from '../layouts/PublicLayout.astro';import Photo from '../components/common/Photo.astro';import Trust from '../components/home/Trust.astro';import CTA from '../components/common/CTA.astro';import {siteData} from '../services/data';import {content,paragraphs} from '../utils/format';const data=await siteData();const hero=content(data.content,'about','hero');const story=content(data.content,'about','story');const mission=content(data.content,'about','mission');
---
<PublicLayout data={data} title="Our story" description={hero?.body}><section class="about-hero"><div class="page-heading"><p class="eyebrow">{hero?.eyebrow}</p><h1>{hero?.title}</h1><p class="lede">{hero?.body}</p></div><Photo src={hero?.image||''} alt="Vibe Stayz identity, inspired by nature" eager sizes="(max-width:767px) 100vw, 50vw"/></section><section class="section container two-column"><Photo src={story?.image||''} alt="A quiet cabin surrounded by tea hills" sizes="(max-width:767px) 100vw, 50vw"/><div><p class="eyebrow">{story?.eyebrow}</p><h2>{story?.title}</h2><div class="prose">{paragraphs(story?.body||'').map(p=><p>{p}</p>)}</div></div></section><section class="container philosophy"><p class="eyebrow">{mission?.eyebrow}</p><h2>{mission?.title}</h2><p>{mission?.body}</p><a class="button button-dark" href={mission?.cta_url}>{mission?.cta_label}</a></section><Trust/><CTA data={data}/></PublicLayout>
