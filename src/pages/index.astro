---
import PublicLayout from '../layouts/PublicLayout.astro';import Photo from '../components/common/Photo.astro';import Icon from '../components/common/Icon.astro';import SectionHeading from '../components/common/SectionHeading.astro';import ResortCard from '../components/resort/ResortCard.astro';import LocationCard from '../components/location/LocationCard.astro';import OfferCard from '../components/home/OfferCard.astro';import Trust from '../components/home/Trust.astro';import CTA from '../components/common/CTA.astro';import {siteData} from '../services/data';import {content,whatsappLink} from '../utils/format';
const data=await siteData();const hero=content(data.content,'home','hero');const featured=content(data.content,'home','featured');const destinations=content(data.content,'home','destinations');const story=content(data.content,'home','story');const offers=content(data.content,'home','offers');const reviews=content(data.content,'home','testimonials');const featuredStays=data.resorts.filter(r=>r.featured);const locations=data.locations.filter(l=>l.featured);const review=data.testimonials[0];
---
<PublicLayout data={data} transparent>
<section class="hero"><Photo src={hero?.image||''} alt="A private tropical villa and infinity pool overlooking the hills at sunset" class="hero-image" eager sizes="100vw"/><div class="container hero-content"><p class="eyebrow">{hero?.eyebrow}</p><h1>{hero?.title}</h1><p class="hero-description">{hero?.body}</p><div class="hero-buttons"><a class="button button-lime" href={hero?.cta_url||'/resorts'}>{hero?.cta_label||'Explore resorts'}<Icon name="arrow" size={18}/></a><a href={whatsappLink(data.settings)} class="button button-white-outline"><Icon name="whatsapp" size={17}/>Enquire on WhatsApp</a></div></div><p class="hero-caption"><Icon name="pin" size={15}/>Your next escape, somewhere beautiful.</p>
<form class="discovery-bar container" action="/resorts" role="search"><div class="search-field"><Icon name="search" size={24}/><label for="hero-search">A place you have in mind<input id="hero-search" name="q" type="search" placeholder="Search a stay or destination"/></label></div><div class="search-field"><Icon name="pin" size={24}/><label for="hero-location">Your destination<select id="hero-location" name="location"><option value="">Anywhere in Kerala</option>{data.locations.map(l=><option value={l.slug}>{l.name}</option>)}</select></label></div><div class="search-field"><Icon name="users" size={24}/><label for="hero-guests">Room for everyone<select name="guests" id="hero-guests"><option value="">Any group size</option><option value="2">2+ guests</option><option value="4">4+ guests</option><option value="8">8+ guests</option><option value="12">12+ guests</option></select></label></div><button class="button button-lime" type="submit"><Icon name="search" size={18}/>Find your stay</button></form></section>
<div class="destination-ribbon"><div class="container">{locations.slice(0,4).map(l=><a href={`/locations/${l.slug}`}><Icon name={l.icon} size={29}/>{l.name}</a>)}</div></div>
<section class="section container home-featured"><SectionHeading eyebrow={featured?.eyebrow} title={featured?.title} body={featured?.body} href={featured?.cta_url} label={featured?.cta_label}/><div class="stays-grid">{featuredStays.slice(0,3).map(r=><ResortCard resort={r}/>)}{!featuredStays.length&&<div class="empty-state"><h2>New escapes are on their way.</h2><p>Our collection is growing. Let us help you find a beautiful stay.</p><a class="button button-dark" href="/contact">Talk to our team</a></div>}</div></section>
<section class="section container destinations-section"><SectionHeading eyebrow={destinations?.eyebrow} title={destinations?.title} body={destinations?.body} href={destinations?.cta_url} label={destinations?.cta_label}/><div class="destinations-grid">{locations.slice(0,4).map(l=><LocationCard location={l} count={data.resorts.filter(r=>r.location_id===l.id).length}/>)}</div></section>
<section class="story-section"><div class="story-image"><Photo src={story?.image||''} alt="A peaceful heritage courtyard and pool" sizes="(max-width:767px) 100vw, 50vw"/><p class="image-note">A little less hurry.<br/>A little more here.</p></div><div class="story-copy"><p class="eyebrow">{story?.eyebrow}</p><h2>{story?.title}</h2><p>{story?.body}</p><a class="button button-lime" href={story?.cta_url}>{story?.cta_label}<Icon name="arrow" size={18}/></a></div></section>
<Trust/>
{data.offers.length>0&&<section class="section offers-section"><div class="container"><SectionHeading eyebrow={offers?.eyebrow} title={offers?.title} body={offers?.body} href={offers?.cta_url} label={offers?.cta_label}/><div class="offers-grid">{data.offers.slice(0,2).map(o=><OfferCard offer={o} settings={data.settings}/>)}</div></div></section>}
{review&&<section class="testimonials-section"><div class="container testimonial-inner"><div class="testimonials-heading"><p class="eyebrow">{reviews?.eyebrow}</p><h2>{reviews?.title}</h2></div><div class="quote-card"><div class="quote-stars" aria-label={`${review.rating} out of 5 stars`}>{Array.from({length:review.rating}).map(()=><Icon name="star" size={14}/>)}</div><blockquote>“{review.quote}”</blockquote><p class="quote-person">{review.name} · {review.location}{review.is_demo===1&&<span class="sample-tag">Sample guest story</span>}</p></div></div></section>}
<CTA data={data}/>
</PublicLayout>
