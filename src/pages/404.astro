---
import PublicLayout from '../layouts/PublicLayout.astro';import Icon from '../components/common/Icon.astro';import {siteData} from '../services/data';const data=await siteData();Astro.response.status=404;
---
<PublicLayout data={data} title="A little off the beaten path" noindex><div class="container section"><div class="empty-state"><p class="eyebrow">404 · THIS PATH ENDS HERE</p><h1>Let’s find you somewhere lovely.</h1><p>This page may have moved, or the stay may no longer be listed. There are more beautiful places to discover.</p><a href="/resorts" class="button button-dark">Explore the stays<Icon name="arrow" size={18}/></a></div></div></PublicLayout>
