---
import PublicLayout from '../layouts/PublicLayout.astro';import OfferCard from '../components/home/OfferCard.astro';import CTA from '../components/common/CTA.astro';import {siteData} from '../services/data';import {content} from '../utils/format';const data=await siteData();const c=content(data.content,'offers','hero');
---
<PublicLayout data={data} title="Offers & escape ideas" description={c?.body}><div class="container"><section class="page-heading"><p class="eyebrow">{c?.eyebrow}</p><h1>{c?.title}</h1><p class="lede">{c?.body}</p></section><section class="results-section"><div class="offers-grid">{data.offers.map(o=><OfferCard offer={o} settings={data.settings}/>)}</div>{!data.offers.length&&<div class="empty-state"><h2>Your next getaway is still waiting.</h2><p>There are no special offers at the moment. Explore our collection or ask our team for a stay suggestion.</p><a class="button button-dark" href="/resorts">Explore resorts</a></div>}<p style="font-size:12px;color:var(--muted);margin-top:25px">Offers are informational. Contact our team for current prices, inclusions and terms.</p></section></div><CTA data={data}/></PublicLayout>
