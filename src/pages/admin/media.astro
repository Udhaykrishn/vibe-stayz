---
import AdminLayout from '../../layouts/AdminLayout.astro';import Icon from '../../components/common/Icon.astro';import MediaPicker from '../../components/admin/MediaPicker.astro';import {rows} from '../../services/data';import type {Media} from '../../types';const media=await rows<Media>('SELECT * FROM media ORDER BY created_at DESC');
---
<AdminLayout title="Media library" description="The photographs that bring your collection to life."><button slot="actions" class="button button-dark" data-open-library><Icon name="plus" size={18}/>Upload image</button><section class="admin-panel"><div class="media-library-grid">{media.map(m=><article><img src={`/media/${m.id}`} alt={m.alt||m.filename} width="300" height="220" loading="lazy"/><div><h2>{m.filename}</h2><p>{Math.round(m.size/1024)} KB · {m.content_type.replace('image/','').toUpperCase()}</p><button class="text-link" data-copy-url={`/media/${m.id}`}>Copy image URL<Icon name="external" size={14}/></button></div></article>)}</div>{!media.length&&<div class="empty-state"><Icon name="image" size={32}/><h2>Every good stay has a story to show.</h2><p>Upload photographs here, then choose them in your property, destination or content editors.</p><button class="button button-dark" data-open-library>Upload your first image</button></div>}<p id="copy-status" role="status"></p></section><MediaPicker/></AdminLayout>
