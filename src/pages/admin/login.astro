---
import '../../styles/global.css';import '../../styles/admin.css';import Icon from '../../components/common/Icon.astro';import {runtime} from '../../lib/env';if(Astro.locals.admin)return Astro.redirect('/admin');const configured=!!runtime().ADMIN_PASSWORD_HASH;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="csrf-token" content={Astro.locals.csrf}/><title>Admin sign in | Vibe Stayz</title></head><body class="login-body"><div class="login-brand-panel"><a href="/"><img src="/images/brand-round.png" alt="Vibe Stayz" width="100" height="100"/></a><div><p class="eyebrow">THE CONTENT STUDIO</p><h1>Beautiful stays.<br/>Thoughtfully managed.</h1><p>A little care behind the scenes.<br/>A lovely experience for every guest.</p></div><a class="text-link light" href="/">Back to the website<Icon name="arrow" size={17}/></a></div><main class="login-main"><form id="admin-login" class="login-form"><p class="eyebrow">WELCOME BACK</p><h2>Your collection awaits.</h2><p>Sign in to manage your stays and website.</p>{!configured&&<div class="error-note">Admin access is not configured yet. The website owner needs to set the server admin credentials.</div>}<div class="field"><label for="username">Username</label><input id="username" name="username" autocomplete="username" required/></div><div class="field"><label for="password">Password</label><input type="password" id="password" name="password" autocomplete="current-password" required/></div><div id="login-error" class="error-note" role="alert" hidden></div><button class="button button-dark" type="submit">Sign in to your workspace<Icon name="arrow" size={18}/></button><p class="login-note">Private access for the Vibe Stayz team.</p></form></main><script>import '../../scripts/admin';</script></body></html>
