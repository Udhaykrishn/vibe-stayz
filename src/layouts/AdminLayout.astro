---
import '../styles/global.css';import '../styles/admin.css';import Icon from '../components/common/Icon.astro';import {cms} from '../lib/cms-config';
const {title='Dashboard',description=''}=Astro.props;const current=Astro.url.pathname;const links=[['/admin','Dashboard','grid'],...Object.entries(cms).filter(([key])=>!['site_settings','navigation','nearby_attractions'].includes(key)).map(([key,c])=>[`/admin/${key}`,c.label,c.icon]),['/admin/nearby_attractions','Attractions','mountain'],['/admin/media','Media library','image'],['/admin/navigation','Navigation','menu'],['/admin/site_settings/global','Settings','settings']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="csrf-token" content={Astro.locals.csrf}/><title>{title} · Vibe Stayz Admin</title><link rel="icon" href="/images/brand-round.png"/></head><body class="admin-body"><a href="#main" class="skip-link">Skip to content</a><aside class="admin-sidebar"><a href="/admin" class="admin-brand"><img src="/images/brand-round.png" alt="Vibe Stayz" width="65" height="65"/><span>VIBE STAYZ<small>THE CONTENT STUDIO</small></span></a><p class="sidebar-caption">YOUR WORKSPACE</p><nav aria-label="Admin navigation">{links.map(([url,label,icon])=><a href={url} class:list={[(url==='/admin'?current===url:current.startsWith(url.replace('/global','')))&&'active']}><Icon name={icon} size={19}/>{label}</a>)}</nav><div class="sidebar-bottom"><a href="/" target="_blank"><Icon name="external" size={17}/>View website</a><button data-logout><Icon name="logout" size={17}/>Sign out</button></div></aside><div class="admin-main"><header class="admin-topbar"><p>Vibe Stayz <span>/</span> {title}</p><a href="/" target="_blank">View website<Icon name="external" size={15}/></a><span class="admin-avatar">VS</span></header><main id="main" class="admin-content"><div class="admin-page-heading"><div><h1>{title}</h1>{description&&<p>{description}</p>}</div><slot name="actions"/></div><slot/></main><footer class="admin-footer">Vibe Stayz · Content studio</footer></div><script>import '../scripts/admin';</script></body></html>
