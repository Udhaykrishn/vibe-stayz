---
import '../styles/global.css';import Icon from '../components/common/Icon.astro';import {whatsappLink,safeJson} from '../utils/format';import type {SiteData} from '../types';import {runtime} from '../lib/env';
interface Props {data:SiteData;title?:string;description?:string;image?:string;transparent?:boolean;noindex?:boolean;schema?:unknown;detail?:boolean;}
const {data,title,description,image,transparent=false,noindex=false,schema,detail=false}=Astro.props;const s=data.settings;
const origin=runtime().SITE_ORIGIN||Astro.url.origin;const canonical=new URL(Astro.url.pathname,origin).href;
const pageTitle=title?`${title} | ${s.site_name}`:s.seo_title;const wa=whatsappLink(s);const current=Astro.url.pathname;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#071f15"/><title>{pageTitle}</title><meta name="description" content={description||s.seo_description}/><link rel="canonical" href={canonical}/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={description||s.seo_description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(image||s.og_image,origin).href}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={pageTitle}/><meta name="twitter:description" content={description||s.seo_description}/><meta name="twitter:image" content={new URL(image||s.og_image,origin).href}/><link rel="icon" href={s.favicon}/>{(noindex||s.show_demo===1)&&<meta name="robots" content="noindex,follow"/>}{schema&&<script is:inline type="application/ld+json" set:html={safeJson(schema)}/>}</head>
<body class:list={[transparent&&'has-hero',detail&&'has-mobile-enquiry']}><a href="#main" class="skip-link">Skip to content</a>
<header class:list={['site-header',transparent&&'transparent']} id="site-header"><div class="header-inner container"><a class="brand" href="/" aria-label={`${s.site_name} home`}><img src={s.logo} alt={s.site_name} width="82" height="82"/></a><nav class="desktop-nav" aria-label="Main navigation">{data.navigation.filter(n=>n.in_header).map(n=><a href={n.url} class:list={[current===n.url&&'active']} aria-current={current===n.url?'page':undefined}>{n.label}</a>)}</nav><a class="header-enquire" href={wa}><Icon name="whatsapp" size={18}/><span>Let’s plan a stay</span></a><button class="menu-toggle" aria-label="Open navigation" aria-haspopup="dialog" data-open-menu><Icon name="menu" size={25}/></button></div></header>
<dialog class="mobile-menu" id="mobile-menu" aria-labelledby="menu-title"><div class="menu-top"><p id="menu-title">Explore {s.site_name}</p><button class="icon-button" data-close-menu aria-label="Close navigation"><Icon name="close"/></button></div><nav aria-label="Mobile navigation">{data.navigation.filter(n=>n.in_header).map(n=><a href={n.url} aria-current={current===n.url?'page':undefined}>{n.label}<Icon name="arrow"/></a>)}</nav><a href={wa} class="button button-lime"><Icon name="whatsapp"/>{s.cta_label}</a><p class="menu-tagline">STAY · ESCAPE · EXPERIENCE</p></dialog>
<main id="main"><slot/></main>
<footer class="site-footer"><div class="container footer-grid"><div class="footer-brand"><a href="/" aria-label={`${s.site_name} home`}><img src={s.logo} alt={s.site_name} width="108" height="108" loading="lazy"/></a><p>{s.footer_description}</p><div class="social-links">{[['instagram','Instagram'],['facebook','Facebook'],['youtube','YouTube'],['linkedin','LinkedIn']].map(([key,label])=>s[key as keyof typeof s]&&<a href={String(s[key as keyof typeof s])} target="_blank" rel="noopener noreferrer">{label}</a>)}</div></div><div><h2>Take a look around</h2>{data.navigation.filter(n=>n.in_footer).map(n=><a href={n.url}>{n.label}</a>)}</div><div><h2>Find your somewhere</h2>{data.locations.slice(0,6).map(l=><a href={`/locations/${l.slug}`}>{l.name}</a>)}</div><div><h2>Let’s talk getaways</h2><a href={wa} class="footer-wa"><Icon name="whatsapp" size={18}/>Enquire on WhatsApp</a>{s.phone&&<a href={`tel:${s.phone}`}>{s.phone}</a>}{s.email&&<a href={`mailto:${s.email}`}>{s.email}</a>}{s.address&&<p>{s.address}</p>}<p class="footer-motto">STAY · ESCAPE · EXPERIENCE</p></div></div><div class="container footer-bottom"><p>© {new Date().getFullYear()} {s.site_name}. {s.copyright}</p><div><a href="/image-credits">Image credits</a><a href="/admin">Admin</a></div></div>{s.show_demo===1&&<div class="demo-notice">Preview collection · Properties, prices and guest stories are examples. Stay imagery is illustrative.</div>}</footer>
{s.floating_enabled===1&&!detail&&<a href={wa} class="floating-wa" aria-label="Enquire on WhatsApp"><Icon name="whatsapp" size={26}/></a>}
<script>
const menu=document.querySelector<HTMLDialogElement>('#mobile-menu');document.querySelector('[data-open-menu]')?.addEventListener('click',()=>menu?.showModal());document.querySelector('[data-close-menu]')?.addEventListener('click',()=>menu?.close());menu?.addEventListener('click',e=>{if(e.target===menu)menu.close();});
const header=document.querySelector('#site-header');const update=()=>header?.classList.toggle('scrolled',window.scrollY>35);window.addEventListener('scroll',update,{passive:true});update();
document.querySelectorAll<HTMLImageElement>('[data-photo]').forEach(img=>{img.addEventListener('error',()=>{img.removeAttribute('srcset');img.src='/images/heritage-640.webp';img.alt='Image temporarily unavailable';},{once:true});});
</script></body></html>
