# Project URL: Supabase Dashboard -> Project Settings -> Data API.
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-only secret key. Never prefix this with NEXT_PUBLIC_ or expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Public Supabase Storage bucket created by the included migration.
SUPABASE_STORAGE_BUCKET=media
ADMIN_USERNAME=admin
# Format: salt:PBKDF2-SHA256-hex, 100000 iterations, 32 output bytes.
ADMIN_PASSWORD_HASH=
# Server-only Groq API key used by the admin property drafting assistant.
GROQ_API_KEY=
# Your canonical public origin, with scheme and without a trailing slash.
SITE_ORIGIN=http://localhost:3000
