# Local development uses a file database. Use a remote libSQL URL in production.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=
# Created automatically when a Vercel Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=
ADMIN_USERNAME=admin
# Format: salt:PBKDF2-SHA256-hex, 100000 iterations, 32 output bytes.
ADMIN_PASSWORD_HASH=
DEMO_MODE=false
# Your canonical public origin, with scheme and without a trailing slash.
SITE_ORIGIN=https://your-domain.example
